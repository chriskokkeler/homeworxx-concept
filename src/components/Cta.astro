---
import { site } from '../data/site';
import { u } from '../lib/url';
interface Props { title?: string; text?: string }
const {
  title = 'Kom eens kijken aan de Berkelkade',
  text = 'Maak vrijblijvend een afspraak. Dan zie je de werkplekken en kijken we samen wat bij je kind past.',
} = Astro.props;
---
<div class="cta reveal">
  <div>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="btn-row">
    <a class="btn btn--sun arrow" href={u('contact')}>Plan een kennismaking</a>
    <a class="btn btn--ghost" href={site.phoneHref} style="border-color: var(--green-300); color: var(--cream)">Bel {site.phone}</a>
  </div>
</div>
