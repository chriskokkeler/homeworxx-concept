---
import Deco from './Deco.astro';
import { u } from '../lib/url';
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="phero">
  <Deco />
  <div class="container stagger" style="position: relative">
    <p class="crumbs"><a href={u()}>Home</a> / {eyebrow}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
